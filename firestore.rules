rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Vault Folders subcollection
      match /vault_folders/{folderId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 128;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Vault Files subcollection
      match /vault_files/{fileId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 256
          && request.resource.data.sizeBytes is int
          && request.resource.data.sizeBytes >= 0
          && request.resource.data.sizeBytes <= 104857600; // 100MB max
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Originality Checks subcollection
      match /originality_checks/{checkId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // AI Chat Messages subcollection
      match /chat_messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
